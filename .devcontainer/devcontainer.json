{
  "name": "PedRec (CUDA training)",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspaces/PedRec",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/PedRec,type=bind",

  // GPU via CDI (nvidia-container-toolkit; `nvidia-ctk cdi list` shows nvidia.com/gpu=all). Needs Docker >= 28.3.
  // Alternative on hosts with the legacy nvidia runtime: "--gpus=all".
  "runArgs": [
    "--device=nvidia.com/gpu=all",
    "--shm-size=16g",
    "--ipc=host",
    "--ulimit=memlock=-1"
  ],

  "mounts": [
    // Conti01 dataset: read-only, at the place the code expects it ($PEDREC_DATA_DIR/datasets/Conti01).
    "source=/mnt/DataNVME/datasets/Conti01,target=/workspaces/PedRec/data/datasets/Conti01,type=bind,readonly",
    // Keep the container's venv / mise installs off the host's .venv (different Python path) in named volumes.
    "source=pedrec-venv,target=/workspaces/PedRec/.venv,type=volume",
    "source=pedrec-mise,target=/home/vscode/.local/share/mise,type=volume",
    "source=pedrec-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],

  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "PYTHONUNBUFFERED": "1"
  },

  // Existing volumes / mount parents may still be root-owned; hand them to the container user, trust mise.toml,
  // then install Python, create the venv (mise only auto-creates a missing dir, the named volume is already there, empty) and install the requirements.
  "postCreateCommand": "sudo chown -R vscode:vscode /workspaces/PedRec/.venv /home/vscode/.local /home/vscode/.cache && mise trust /workspaces/PedRec/mise.toml && mise install && mise exec -- uv venv --allow-existing .venv && mise run setup && mise run gpu:info",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-toolsai.jupyter", "tamasfe.even-better-toml"],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/PedRec/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
